<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Hatch's wire contract, and nothing else: the records the API serves and the
    records a client sends it.

    A project of its own because there are now two implementations of "a client
    of Hatch" in this repository - the web apps, which get their types from the
    OpenAPI document, and Hatch.Cli, which is compiled against these. A
    runner that redeclared the shape of a dispatch would drift from the server
    the first time somebody added a field, and drift silently, because JSON
    does not complain about what it did not find.

    Nothing here references EF, ASP.NET or the database. A contract that needed
    a DbContext to compile would be a contract only the server could hold.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The cast list RunnerCast picks a checkout's name from. Embedded rather than
    read from disk: the binary is trimmed and single-file (see above), and a
    published `hatch` carries no sibling files with it. A fixed LogicalName is
    what makes reading it back with GetManifestResourceStream one line rather
    than a search over GetManifestResourceNames for whatever the default naming
    convention did to the path.
  -->
  <ItemGroup>
    <EmbeddedResource Include="runner-names.txt" LogicalName="runner-names.txt" />
  </ItemGroup>

  <!--
    The install recipes DependencyRecipes renders, one Dockerfile fragment per
    dependency id. Embedded for the same reason as the cast list: a published
    binary is trimmed and single-file, so they cannot be read from disk. The
    logical name is `recipes/<id>.Dockerfile`, which is what Recipe(id) asks
    for. A folder with no recipe in it matches nothing, and that is fine.
  -->
  <ItemGroup>
    <EmbeddedResource Include="recipes/*.Dockerfile" LogicalName="recipes/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hatch.Api.Tests" />
  </ItemGroup>

</Project>
