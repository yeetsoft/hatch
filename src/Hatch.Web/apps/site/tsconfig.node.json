{
  "compilerOptions": {
    "composite": true,
    "outDir": "./node_modules/.tmp/node-build",
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node", "vite/client"]
  },
  "include": ["vite.config.ts", "vite-plugin-site.ts", "vite-plugin-docs.ts", "src/siteEnv.ts"]
}
