# Build the SPAs (Hatch.Web/apps/*) separately - the .NET SDK image has no Node
# runtime, and their outputs are committed to wwwroot/apps/* as static web
# assets of Hatch.Api.
#
# One stage, not one per app. Hatch.Web is an npm workspace with a single
# hoisted lockfile, so per-app stages could no longer cache independently
# anyway: any app's dependency change rewrites the one lockfile and busts every
# stage's `npm ci`. Six stages would pay the install cost six times to buy
# nothing; this pays it once.
#
# HATCH_REVISION/HATCH_SEQUENCE are the git identity of this build (see
# docs/plans/version.md). This stage takes them because
# ../Hatch.Web/vite-plugin-hatch-revision.mts stamps them into each app's
# index.html; the SDK stage takes them because the API reads its own out of the
# assembly. Declared per stage rather than once at the top: a build arg is
# scoped to the stage that declares it, and a global ARG before the first FROM
# is *not* inherited by the stages below it.
#
# The ARG lines sit after `npm ci` on purpose. A build arg only invalidates the
# layers that reference it, so a new commit rebuilds index.html without
# re-resolving the dependency tree.
FROM node:22-alpine AS web-build
WORKDIR /repo

# Every workspace's package.json is an input to `npm ci`, so they are copied
# ahead of the sources: an edit to any app's *code* then reuses this layer.
COPY src/Hatch.Web/package.json src/Hatch.Web/package-lock.json src/Hatch.Web/
COPY src/Hatch.Web/apps/design/package.json src/Hatch.Web/apps/design/
COPY src/Hatch.Web/apps/auth/package.json src/Hatch.Web/apps/auth/
COPY src/Hatch.Web/apps/hatch/package.json src/Hatch.Web/apps/hatch/
# The shared package is a workspace too: `npm ci` reads the lockfile, finds a
# link: entry for it, and fails outright if this package.json is not on disk.
# It has no build script, so `--workspaces --if-present` below skips it and the
# consuming apps bundle its source.
COPY src/Hatch.Web/packages/ui/package.json src/Hatch.Web/packages/ui/
RUN npm --prefix src/Hatch.Web ci

COPY src/Hatch.Web src/Hatch.Web
ARG HATCH_REVISION
ARG HATCH_SEQUENCE
# Where this repository publishes its setup guide (src/Hatch.Web/apps/site/content/setup.md), stamped into
# index.html beside the revision for the gear's Setup Prompt and the Docs page.
# publish.yml supplies it; a local `docker compose up` does not, and the board
# then offers no setup line rather than one that names somebody else's site.
ARG HATCH_SETUP_GUIDE
ENV HATCH_REVISION=$HATCH_REVISION HATCH_SEQUENCE=$HATCH_SEQUENCE HATCH_SETUP_GUIDE=$HATCH_SETUP_GUIDE
RUN npm --prefix src/Hatch.Web run build --workspaces --if-present

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build-env
WORKDIR /App

# Restore from the project files alone, ahead of the sources: what restore reads
# is the dependency graph, so an edit to code reuses this layer and only a
# change to a project file (or what it references) pays for it again.
COPY src/Hatch.Contracts/Hatch.Contracts.csproj src/Hatch.Contracts/
COPY src/Hatch.Api/Hatch.Api.csproj src/Hatch.Api/
RUN dotnet restore src/Hatch.Api/Hatch.Api.csproj

# Copy what the API is built from (build context is the repo root - see
# compose.yaml / the release workflow - so Hatch.Api can reach its sibling
# Hatch.Web project), and not the rest of the repository: a doc, a script, a
# test or the site is nothing the API publish reads, and copying them would
# rerun it for every edit to one.
COPY src/Hatch.Contracts src/Hatch.Contracts
COPY src/Hatch.Api src/Hatch.Api
COPY src/Hatch.Web src/Hatch.Web
COPY --from=web-build /repo/src/Hatch.Api/wwwroot/apps ./src/Hatch.Api/wwwroot/apps

# Build and publish a release. The SPAs (from Hatch.Web) were already built above, so skip
# the MSBuild targets that would otherwise shell out to npm (unavailable here).
# Every Build<App> target in Hatch.Api.csproj has a Skip<App>Build switch, and each
# one must be passed below, or the publish reaches for npm and fails.
#
# SourceRevisionId is .NET's own mechanism rather than an env var on the runtime
# image: it appends "+<sha>" to AssemblyInformationalVersion, which puts the
# revision *in the binary*. That is the point - a revision the deployment can
# supply is a revision the deployment can get wrong, and every use of this value
# is a use that has to trust it (see Services/HatchRevision.cs).
ARG HATCH_REVISION
ARG HATCH_SEQUENCE
RUN dotnet publish src/Hatch.Api/Hatch.Api.csproj -c Release -o out -p:SkipDesignBuild=true -p:SkipAuthBuild=true -p:SourceRevisionId=$HATCH_REVISION -p:HatchSequence=$HATCH_SEQUENCE

# The runner, one self-contained binary per platform this house supports, so a
# friend downloads a program rather than an SDK. Built from this same commit,
# which is what lets the Runner page print one revision for the image and the
# binary it hands out alike.
#
# One stage per platform, and each copies only what the CLI is built from
# (itself and Hatch.Contracts). Two things follow: BuildKit runs independent
# stages at the same time, so four trimmed publishes cost about the longest of
# them rather than the sum; and a change to the API, the web apps, a doc or a
# script leaves all four layers as they were, where one `RUN` loop after
# `COPY . ./` rebuilt every platform for any edit anywhere.
#
# Inlined rather than `make publish-hatch`: these stages' SDK image carries no
# `make`, and the two are the same lines either way. The platform list is the
# Makefile's HATCH_RIDS - if one moves, the stages here move with it, and so
# does the COPY --from list in the runtime image below. See AERIE-935.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS cli-src
WORKDIR /App
COPY src/Hatch.Contracts src/Hatch.Contracts
COPY src/Hatch.Cli src/Hatch.Cli

FROM cli-src AS cli-win-x64
ARG HATCH_REVISION
ARG HATCH_SEQUENCE
RUN dotnet publish src/Hatch.Cli/Hatch.Cli.csproj \
      --runtime win-x64 \
      --configuration Release \
      --output /out \
      -p:PublishSingleFile=true \
      -p:SelfContained=true \
      -p:PublishTrimmed=true \
      -p:SourceRevisionId=$HATCH_REVISION \
      -p:HatchSequence=$HATCH_SEQUENCE

FROM cli-src AS cli-osx-arm64
ARG HATCH_REVISION
ARG HATCH_SEQUENCE
RUN dotnet publish src/Hatch.Cli/Hatch.Cli.csproj \
      --runtime osx-arm64 \
      --configuration Release \
      --output /out \
      -p:PublishSingleFile=true \
      -p:SelfContained=true \
      -p:PublishTrimmed=true \
      -p:SourceRevisionId=$HATCH_REVISION \
      -p:HatchSequence=$HATCH_SEQUENCE

FROM cli-src AS cli-osx-x64
ARG HATCH_REVISION
ARG HATCH_SEQUENCE
RUN dotnet publish src/Hatch.Cli/Hatch.Cli.csproj \
      --runtime osx-x64 \
      --configuration Release \
      --output /out \
      -p:PublishSingleFile=true \
      -p:SelfContained=true \
      -p:PublishTrimmed=true \
      -p:SourceRevisionId=$HATCH_REVISION \
      -p:HatchSequence=$HATCH_SEQUENCE

FROM cli-src AS cli-linux-x64
ARG HATCH_REVISION
ARG HATCH_SEQUENCE
RUN dotnet publish src/Hatch.Cli/Hatch.Cli.csproj \
      --runtime linux-x64 \
      --configuration Release \
      --output /out \
      -p:PublishSingleFile=true \
      -p:SelfContained=true \
      -p:PublishTrimmed=true \
      -p:SourceRevisionId=$HATCH_REVISION \
      -p:HatchSequence=$HATCH_SEQUENCE

# Build runtime image
FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /App

# Npgsql probes for a Kerberos library on every connect, to see whether GSSAPI
# authentication is on the table. The aspnet runtime image carries none, so the
# probe fails and the loader writes two lines to stderr beginning with `Error:`
# - before anything the app itself logs, on both a serving start and a migrate
# run. They are the first thing a new operator sees and they say nothing is
# wrong. About a megabyte to make them go away.
#
# postgresql-client-18 gives the api image its own pg_dump, pinned to the same
# Postgres major containers/hatch-db/Dockerfile.db pins today. This base image
# is Ubuntu 24.04 (noble), whose own postgresql-client candidate is two majors
# behind - so the PGDG apt repo is added first, the same shape this repository
# already uses for the GitHub CLI repo in containers/hatch-runner/Dockerfile.
# PGDG's key is ASCII-armored, unlike GitHub's, hence the `gpg --dearmor` step.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
 && mkdir -p -m 755 /etc/apt/keyrings \
 && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      | gpg --dearmor -o /etc/apt/keyrings/postgresql.gpg \
 && echo "deb [signed-by=/etc/apt/keyrings/postgresql.gpg] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo "$VERSION_CODENAME")-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list \
 && apt-get update \
 && apt-get install -y --no-install-recommends libgssapi-krb5-2 postgresql-client-18 \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build-env /App/out .
# The four platform binaries RunnerController serves. Beside wwwroot/apps
# rather than inside it: the static file handlers in Program.cs mount
# wwwroot/apps at /apps and nothing else, so this directory is reachable only
# through the controller - which is what keeps the download behind the same
# [RequireAdmin] as the page that offers it. See AERIE-935.
COPY --from=cli-win-x64 /out ./wwwroot/hatch-runner/win-x64
COPY --from=cli-osx-arm64 /out ./wwwroot/hatch-runner/osx-arm64
COPY --from=cli-osx-x64 /out ./wwwroot/hatch-runner/osx-x64
COPY --from=cli-linux-x64 /out ./wwwroot/hatch-runner/linux-x64
ENTRYPOINT ["dotnet", "Hatch.Api.dll"]
