<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="HADotNet.Core" Version="1.6.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.2" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2" />
    <PackageReference Include="Quartz" Version="3.15.1" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="3.15.1" />
    <PackageReference Include="Quartz.Extensions.DependencyInjection" Version="3.15.1" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.15.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Hatch.Contracts/Hatch.Contracts.csproj" />
  </ItemGroup>

  <!--
    The wire records live in Hatch.Contracts and are used by name all over
    Modules/Hatch. Imported globally rather than with a `using` at the top of
    thirty files, so that moving them out of this assembly cost no call site
    anything - the compiler still checks every one of them against the same
    declaration, which is the whole point of the move.
  -->
  <ItemGroup>
    <Using Include="Hatch.Contracts" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hatch.Api.Tests" />
  </ItemGroup>

  <!--
    The git identity of this build (docs/plans/version.md). The sha rides in on
    SourceRevisionId, which the SDK already appends to
    AssemblyInformationalVersion as "+<sha>" - there is no equivalent well-known
    property for an ordering, so the sequence travels as assembly metadata.
    Both are read back by Services/HatchRevision.cs.

    Conditioned so a local `dotnet build` - which passes neither - emits no
    empty attribute, leaving the reader to report `dev` rather than an
    ambiguous "". A dev machine's sha in a dev machine's artifact would answer
    nobody's question anyway, so nothing here shells out to git.
  -->
  <ItemGroup Condition="'$(HatchSequence)' != ''">
    <AssemblyMetadata Include="HatchSequence" Value="$(HatchSequence)" />
  </ItemGroup>

  <!--
    The Web SDK implicitly globs loose project-directory files as Content
    (CopyToPublishDirectory=PreserveNewest). Without this, the local secrets
    file gets copied into bin/ and any publish output, container images
    included - see .env.json usage in Program.cs.
  -->
  <ItemGroup>
    <Content Remove=".env.json" />
  </ItemGroup>

  <!--
    Builds the Hatch.Web SPAs into wwwroot/apps ahead of every build. Requires
    Node 22+ on PATH (see ../Hatch.Web/.nvmrc) - `dotnet build` will fail with
    an old/missing npm otherwise. Skipped in Docker, where the apps are built in
    the web-build stage and copied in (see Dockerfile.api).

    Hatch.Web is one npm workspace with one lockfile, so the install happens
    once, at the root, rather than per app: NpmInstall below is the only target
    that shells out to `npm install`, and every Build<App> depends on it. Each
    app then builds with `npm run build -w apps/<app>`, run from the workspace
    root because that is where node_modules lives.

    The Inputs/Outputs globs stay per-app - that is what keeps an edit to one
    app from rebuilding the other five. An app that starts consuming a shared
    package under ../Hatch.Web/packages/ must add that path to its own glob, or
    a library edit will not retrigger its incremental build.
  -->
  <Target Name="NpmInstall" Condition="!Exists('../Hatch.Web/node_modules')">
    <Exec Command="npm install" WorkingDirectory="../Hatch.Web" />
  </Target>

  <!--
    The sign-in shell every refusal redirects to. (There is no BuildHatch
    target yet, so apps/hatch is not built by dotnet build; that is separate
    from this. The design gallery used to have a target here too - HA-2250
    folded it into apps/hatch, so it now builds with apps/hatch, outside any
    MSBuild target, same as apps/hatch always has.)
  -->
  <ItemGroup>
    <AuthSource Include="../Hatch.Web/apps/auth/src/**/*.*;../Hatch.Web/apps/auth/public/**/*.*;../Hatch.Web/apps/auth/index.html;../Hatch.Web/apps/auth/package.json;../Hatch.Web/apps/auth/vite.config.ts;../Hatch.Web/packages/*/src/**/*.*;../Hatch.Web/packages/*/package.json" />
  </ItemGroup>

  <Target Name="BuildAuth" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipAuthBuild)' != 'true'" Inputs="@(AuthSource)" Outputs="wwwroot/apps/auth/index.html">
    <Exec Command="npm run build -w apps/auth" WorkingDirectory="../Hatch.Web" />
  </Target>

  <!--
    The shared bar and the stylesheet that dresses Swagger UI from the tokens
    (apps/chrome, loaded by the UseSwaggerUI call in Program.cs). It is a
    script and two stylesheets rather than an index.html, so the output the
    incremental check watches is topbar.js. The library under packages/ is in
    the glob because the bar is that library's code and this app only builds it.
  -->
  <ItemGroup>
    <ChromeSource Include="../Hatch.Web/apps/chrome/src/**/*.*;../Hatch.Web/apps/chrome/public/**/*.*;../Hatch.Web/apps/chrome/package.json;../Hatch.Web/apps/chrome/vite.config.ts;../Hatch.Web/packages/*/src/**/*.*;../Hatch.Web/packages/*/package.json" />
  </ItemGroup>

  <Target Name="BuildChrome" BeforeTargets="Build" DependsOnTargets="NpmInstall" Condition="'$(SkipChromeBuild)' != 'true'" Inputs="@(ChromeSource)" Outputs="wwwroot/apps/chrome/topbar.js">
    <Exec Command="npm run build -w apps/chrome" WorkingDirectory="../Hatch.Web" />
  </Target>
</Project>